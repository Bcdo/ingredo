POSTGRES_DB=ingredo
POSTGRES_USER=ingredo
POSTGRES_PASSWORD=change_me_locally
# JWT signing key — generate your own long random value (>= 32 bytes), e.g.:
#   openssl rand -base64 48
JWT_KEY=replace-with-a-long-random-string-of-at-least-32-bytes
# Cloudflare Tunnel token (production only) — Cloudflare dashboard →
# Zero Trust → Networks → Tunnels → the "ingredo" tunnel → token.
TUNNEL_TOKEN=paste-tunnel-token-here
